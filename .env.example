# Copy to .env.local. Only PUBLIC values belong in VITE_* variables: they are bundled into the browser build.
# Project URL (Supabase dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. Safe for the browser ONLY because Row Level Security is enabled on every table.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Synthetic email domain. Login is by PHONE NUMBER: 01712345678 -> 8801712345678@<this domain> (the Supabase Auth account email).
# The Edge Function secret MEMBER_AUTH_EMAIL_DOMAIN must have the same value.
VITE_MEMBER_AUTH_EMAIL_DOMAIN=members.ibadat.example

# Public contact details shown on the Contact page. Each is optional: leave blank to hide it. Not invented for you.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# NEVER put these in a VITE_* variable or commit them. They belong only in Edge Function secrets / server environments:
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_PASSWORD, any third-party API secret
